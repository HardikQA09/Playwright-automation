GMAIL_USER=imhardikthanki@gmail.com
GMAIL_APP_PASSWORD=
AUTH_EMAIL_VERIFICATION_REQUIRED=true

# --- Emailing the execution report (npm run report:email / scheduled:* / complete) ---
# Comma separated. Every REPORT_EMAIL_TO / CC (including per-schedule lists) is sent.
REPORT_EMAIL_TO=pankaj.bhatla@ooltool.com,syesha.sen@ooltool.com,chetan.thumar@quantuminfoway.com,vishal.chauhan@quantuminfoway.com,hardik.thanki@quantuminfoway.com
REPORT_EMAIL_CC=
# Optional extra recipients per schedule. These are added, they do not replace the lists above.
# REPORT_EMAIL_TO_DAILY=
# REPORT_EMAIL_TO_EVERY_2_DAYS_RUN=
# REPORT_EMAIL_TO_WEEKLY=
# Never send here. Rob (local part rob / robert) is also excluded from the schedule.
REPORT_EMAIL_EXCLUDE=
# Sends through Gmail with GMAIL_USER / GMAIL_APP_PASSWORD by default.
# Use these to send through another mail server instead.
# REPORT_SMTP_HOST=smtp.office365.com
# REPORT_SMTP_PORT=587
# REPORT_SMTP_USER=
# REPORT_SMTP_PASS=
# REPORT_EMAIL_FROM=
# Optional link to a hosted copy of the report, shown in the email
# REPORT_URL=
